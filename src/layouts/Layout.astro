---
import '../styles/archive.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = 'a travel log drawn as one continuous line', ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><circle cx='8' cy='8' r='5' fill='%23FF6F1E'/></svg>"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
