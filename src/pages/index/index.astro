---
import Overview from '../../components/Overview.astro';
import Layout from '../../layouts/Layout.astro';
import { HOME, ORIGIN } from '../../config';
import { loadContent } from '../../lib/content';
import { fmtDMY, fmtMY } from '../../lib/format';
import { photoDims } from '../../lib/photos';
import { buildWorld } from '../../lib/world';

/* The boring index: reverse-chronological, grouped by trip. Also the
   reduced-motion / no-JS home, together with the static overview. */

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const content = loadContent();
const world = buildWorld(content.trips, photoDims);
const trips = content.trips.slice().reverse();
---

<Layout title="index — on roam">
  <main class="fallback plain">
    <h1><a href={base}>on roam</a> — index</h1>
    <p class="lede">EVERY POST, NEWEST FIRST</p>
    <Overview world={world} home={HOME.name} origin={ORIGIN.name} />
    {trips.map((trip) => (
      <section class="trip">
        <h2>
          {trip.place.toLowerCase()} — {trip.name}
          <span class="range">{fmtMY(new Date(Date.parse(trip.start)))}</span>
        </h2>
        <ul>
          {trip.posts
            .slice()
            .reverse()
            .map((post) => (
              <li>
                <span class="d">{fmtDMY(new Date(Date.parse(post.date)))}</span>
                <a href={`${base}p/${post.slug}/`}>{post.title}</a>
                {post.slug === trip.cover.slug && <span class="cov">· cover</span>}
              </li>
            ))}
        </ul>
      </section>
    ))}
  </main>
</Layout>

<style>
  .plain { display: block; }
  .plain h1 { font-size: 24px; }
  .plain h1 a { color: inherit; text-decoration: none; }
  .plain h1 a:hover { text-decoration: underline; }
  .trip { margin-bottom: 34px; }
  .trip h2 { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 19px; margin-bottom: 10px; }
  .trip .range { font-family: var(--mono); font-style: normal; font-size: 10px; letter-spacing: 0.2em;
                 color: var(--mute); margin-left: 12px; }
  .trip ul { list-style: none; }
  .trip li { display: flex; gap: 14px; align-items: baseline; padding: 5px 0; font-size: 14px; }
  .trip .d { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; color: var(--mute); min-width: 96px; }
  .trip .cov { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; color: var(--stamp); }
</style>
