---
import { getImage } from 'astro:assets';
import { HOME, ORIGIN } from '../config';
import { loadContent } from '../lib/content';
import { fmtDMY, fmtMY, fmtStamp } from '../lib/format';
import { photoDims, photoMeta } from '../lib/photos';
import { buildWorld } from '../lib/world';
import type { Post } from '../lib/types';
import Overview from './Overview.astro';

/* The whole archive page: world geometry + content laid out server-side,
   camera + interactions driven by src/client/archive.ts. */

interface Props {
  openSlug?: string; // /p/<slug> deep link: open this post's overlay on load
}
const { openSlug } = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const content = loadContent();
const world = buildWorld(content.trips, photoDims);

const postBySlug = new Map(content.posts.map((p) => [p.slug, p]));

/* web derivatives (originals untouched) */
interface ImgRef { src: string; w: number; h: number; }
const imgs: Record<string, { small: ImgRef; large: ImgRef }> = {};
for (const post of content.posts) {
  const meta = photoMeta[post.slug];
  if (!meta) throw new Error(`No photo.jpg for post "${post.slug}"`);
  const smallW = Math.min(320, meta.width);
  const largeW = Math.min(1200, meta.width);
  const small = await getImage({ src: meta, width: smallW, format: 'webp' });
  const large = await getImage({ src: meta, width: largeW, format: 'webp' });
  imgs[post.slug] = {
    small: { src: small.src, w: smallW, h: Math.round((smallW * meta.height) / meta.width) },
    large: { src: large.src, w: largeW, h: Math.round((largeW * meta.height) / meta.width) },
  };
}

/* everything the client script needs, inlined as JSON */
const clientData = {
  base,
  home: HOME.name,
  origin: ORIGIN.name,
  tEnd: world.tEnd,
  total: Math.round(world.arc.total * 10) / 10,
  bbox: world.bbox,
  px: world.arc.px.map((v) => Math.round(v * 10) / 10),
  py: world.arc.py.map((v) => Math.round(v * 10) / 10),
  cum: world.arc.cum.map((v) => Math.round(v * 10) / 10),
  spans: world.spans.map((m) => ({ type: m.type, s0: m.s0, s1: m.s1, d0: m.d0, d1: m.d1, place: m.place })),
  posts: Object.fromEntries(
    content.posts.map((p) => [
      p.slug,
      {
        title: p.title,
        place: p.place,
        date: Date.parse(p.date),
        desc: p.description,
        cap: p.title.toLowerCase(),
        type: p.type ?? 'photo',
        s: Math.round((world.postS[p.slug] ?? 0) * 10) / 10,
        small: imgs[p.slug]!.small,
        large: imgs[p.slug]!.large,
      },
    ]),
  ),
};
const dataJSON = JSON.stringify(clientData).replace(/</g, '\\u003c');

const openPost: Post | undefined = openSlug ? postBySlug.get(openSlug) : undefined;
const openParas = openPost ? openPost.description.split(/\n{2,}/).map((t) => t.trim()) : [];

const round = (v: number) => Math.round(v * 10) / 10;
---

<div class="spacer" aria-hidden="true" style={`height:calc(${Math.ceil(world.arc.total)}px + 100vh)`}></div>

<div class="stage">
  <div class="world" id="world" style={`width:${world.W}px;height:${world.H}px`}>
    <svg width={world.W} height={world.H} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      {world.spans.map((sp) => (
        <path d={sp.d} class={sp.type === 'home' ? 'seg-dash' : 'seg-solid'} />
      ))}
    </svg>

    <div class="home-label" style={`left:${round(world.origin.x)}px;top:${round(world.origin.y + 26)}px`}>
      {ORIGIN.name}
    </div>
    <div class="home-label" style={`left:${round(world.home.x)}px;top:${round(world.home.y - 26)}px`}>
      {HOME.name}
    </div>

    {world.keyframes.map((kf) => {
      const post = postBySlug.get(kf.slug)!;
      const img = imgs[kf.slug]!.small;
      return (
        <a
          class="keyframe"
          href={`${base}p/${kf.slug}/`}
          data-post={kf.slug}
          data-s={round(kf.s)}
          style={`left:${round(kf.x)}px;top:${round(kf.y)}px;--tilt:${kf.tilt}deg`}
          aria-label={`Open ${post.place} cover photo: ${post.title}`}
        >
          <span class="photo">
            <img src={img.src} width={img.w} height={img.h} alt={post.title} loading="lazy" decoding="async" />
            {post.type === 'reflection' && <span class="ptitle">{post.title}</span>}
            <span class="stamp">{fmtStamp(new Date(Date.parse(post.date)))}</span>
          </span>
        </a>
      );
    })}

    {world.labels.map((l) => (
      <button
        class="place"
        data-jump={round(l.s0)}
        data-s={round(l.s)}
        style={`left:${round(l.x)}px;top:${round(l.y)}px`}
      >
        {l.place} <span class="yr">· {fmtMY(new Date(l.d0))}</span>
      </button>
    ))}

    {world.dots.map((d) => {
      const post = postBySlug.get(d.slug)!;
      return (
        <a
          class="dot"
          href={`${base}p/${d.slug}/`}
          data-post={d.slug}
          data-s={round(d.s)}
          style={`left:${round(d.x)}px;top:${round(d.y)}px`}
          aria-label={`Open post from ${post.place}: ${post.title}`}
        >
          <i></i>
        </a>
      );
    })}

    <div class="now" data-s={round(world.now.s)} style={`left:${round(world.now.x)}px;top:${round(world.now.y)}px`}>
      <span class="pip"></span><span>STILL ROAMING</span>
    </div>
  </div>
</div>

<div class="wordmark" aria-hidden="true">
  <svg width="34" height="16" viewBox="0 0 34 16">
    <path
      d="M1 12 C 6 12, 7 4, 12 4 S 18 13, 23 11 S 28 5, 31 5"
      fill="none"
      stroke="var(--ink)"
      stroke-width="1.3"
    />
    <circle cx="31" cy="5" r="2.1" fill="var(--stamp)"></circle>
  </svg>
  <span class="name">on roam</span>
</div>

<div class="marker"><span class="pip"></span><span id="markerText">…</span></div>
<div class="hint" id="hint">scroll ↓ to roam</div>

<div class="controls">
  <button id="btnOverview">the roam so far</button>
</div>

<div class="compass" aria-hidden="true">
  <svg width="52" height="52" viewBox="0 0 52 52">
    <circle cx="26" cy="26" r="20" fill="none" stroke="var(--hairline)" stroke-width="1"></circle>
    <text x="26" y="9" text-anchor="middle" class="nlab">N</text>
    <g class="needle" id="needle">
      <line x1="26" y1="26" x2="26" y2="12" stroke="var(--stamp)" stroke-width="1.6"></line>
      <line x1="26" y1="26" x2="26" y2="34" stroke="var(--mute)" stroke-width="1.2"></line>
    </g>
  </svg>
</div>

<div class="preview" id="preview"></div>

<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-label="Post">
  <div class="post" id="postCard"></div>
</div>

<!-- reduced-motion / no-JS experience: static article + pannable overview + plain index -->
<section class="fallback">
  <h1>on roam</h1>
  <p class="lede">A TRAVEL LOG DRAWN AS ONE CONTINUOUS LINE</p>
  {openPost && (
    <article class={openPost.type === 'reflection' ? 'reflection' : undefined}>
      <span class="photo" style="max-width:560px">
        <img
          src={imgs[openPost.slug]!.large.src}
          width={imgs[openPost.slug]!.large.w}
          height={imgs[openPost.slug]!.large.h}
          alt={openPost.title}
        />
        {openPost.type === 'reflection' && <span class="ptitle">{openPost.title}</span>}
        <span class="stamp">{fmtStamp(new Date(Date.parse(openPost.date)))}</span>
      </span>
      {openPost.type !== 'reflection' && <h2>{openPost.title}</h2>}
      <div class="meta">{openPost.place} · {fmtDMY(new Date(Date.parse(openPost.date)))}</div>
      {openParas.map((t) => <p>{t}</p>)}
    </article>
  )}
  <Overview world={world} home={HOME.name} origin={ORIGIN.name} />
  <p><a href={`${base}index/`}>browse every post as a plain list →</a></p>
</section>

<noscript>
  <style>
    .stage, .marker, .hint, .controls, .compass, .preview, .overlay, .spacer { display: none !important; }
    .fallback { display: block; }
  </style>
</noscript>

<script type="application/json" id="roam-data" set:html={dataJSON} />
{openSlug && <script is:inline define:vars={{ openSlug }}>document.body.dataset.openSlug = openSlug;</script>}

<script>
  import '../client/archive.ts';
</script>
